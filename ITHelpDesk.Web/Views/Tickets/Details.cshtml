@model ITHelpDesk.Entities.Ticket

<h1>Destek Talebi Detayı</h1>

<div class="card">
    <div class="card-body">
        <h4>@Model.Title</h4>

        <hr />

        <p><strong>Talep No:</strong> @Model.Id</p>
        <p><strong>Talebi Oluşturan:</strong> @Model.User?.FullName</p>
        <p><strong>Açıklama:</strong> @Model.Description</p>
        <p><strong>Kategori:</strong> @Model.Category?.Name</p>
        <p><strong>Öncelik:</strong> @Model.Priority?.Name</p>
        <p><strong>Durum:</strong> @Model.Status?.Name</p>
        <p>
            <strong>Oluşturulma Tarihi:</strong>
            @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
        </p>

        <hr />

        <h4>Yorumlar</h4>

        @if (Model.Comments != null && Model.Comments.Any())
        {
            @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedDate))
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <strong>@comment.User?.FullName</strong>
                        <small class="text-muted">
                            @comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </small>
                        <p class="mb-0">@comment.CommentText</p>
                    </div>
                </div>
            }
        }
        else
        {
            <p>Henüz yorum yapılmamış.</p>
        }

        <hr />

        <a asp-action="Index" class="btn btn-secondary">
            Listeye Dön
        </a>
    </div>
</div>
