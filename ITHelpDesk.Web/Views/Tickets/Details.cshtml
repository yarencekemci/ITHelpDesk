
@model ITHelpDesk.Entities.Ticket

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Destek Talebi Detayı</h2>
            <p class="text-muted mb-0">Talep No: #@Model.Id</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Listeye Dön
        </a>
    </div>

    <!-- talep bilgileri -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="fw-bold">@Model.Title</h4>
            <hr />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Talep Sahibi</strong>
                    <p>@Model.User?.FullName</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Atanan Personel</strong>
                    <p>@(Model.AssignedTo?.FullName ?? "Henüz atanmadı")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Kategori</strong>
                    <p>@Model.Category?.Name</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Öncelik</strong>
                    <p>@Model.Priority?.Name</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Durum</strong>
                    <p>@Model.Status?.Name</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Oluşturulma Tarihi</strong>
                    <p>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</p>
                </div>
            </div>

            <hr />

            <h5 class="fw-bold">Talep Açıklaması</h5>
            <p class="mb-0">@Model.Description</p>
        </div>
    </div>

    <!-- yorum geçmişi -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Yanıt ve Yorum Geçmişi</h5>

            @if (Model.Comments != null && Model.Comments.Any())
            {
                @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedDate))
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between">
                            <strong>@(comment.User?.FullName ?? "Bilinmeyen Kullanıcı")</strong>
                            <small class="text-muted">
                                @comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>

                        <p class="mb-0 mt-2">@comment.CommentText</p>
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">Henüz yorum veya yanıt bulunmuyor.</p>
            }
        </div>
    </div>

</div>
