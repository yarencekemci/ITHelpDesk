@model ITHelpDesk.Entities.Ticket

<h1>Destek Talebi Detayı</h1>

<div class="card">
    <div class="card-body">
        <h4>@Model.Title</h4>

        <hr />

        <p><strong>Talep No:</strong> @Model.Id</p>
        <p><strong>Açıklama:</strong> @Model.Description</p>
        <p><strong>Kategori:</strong> @Model.Category?.Name</p>
        <p><strong>Öncelik:</strong> @Model.Priority?.Name</p>
        <p><strong>Durum:</strong> @Model.Status?.Name</p>
        <p>
            <strong>Oluşturulma Tarihi:</strong>
            @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
        </p>

        <a asp-action="Index" class="btn btn-secondary">
            Listeye Dön
        </a>
    </div>
</div>
