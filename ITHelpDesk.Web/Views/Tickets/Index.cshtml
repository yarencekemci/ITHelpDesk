
@model List<ITHelpDesk.Entities.Ticket>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Destek Talepleri</h1>

    <a asp-action="Create" class="btn btn-primary">
        + Yeni Destek Talebi
    </a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Talep No</th>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>Kategori</th>
            <th>Öncelik</th>
            <th>Durum</th>
            <th>Oluşturulma Tarihi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center">
                    Henüz destek talebi bulunmuyor.
                </td>
            </tr>
        }
        else
        {
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@ticket.Id">
                            @ticket.Id
                        </a>
                    </td>
                    <td>@ticket.Title</td>
                    <td>@ticket.Description</td>
                    <td>@ticket.Category?.Name</td>
                    <td>@ticket.Priority?.Name</td>
                    <td>@ticket.Status?.Name</td>
                    <td>@ticket.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@ticket.Id"
                           class="btn btn-warning btn-sm">
                            Düzenle
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@ticket.Id"
                              method="post"
                              onsubmit="return confirm('Bu destek talebini silmek istediğine emin misin?');">
                            <button type="submit" class="btn btn-danger btn-sm">
                                Sil
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
