
@model List<ITHelpDesk.Entities.Ticket>

<h1>Destek Talepleri</h1>

<table class="table">
    <thead>
        <tr>
            <th>Talep No</th>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>Kategori</th>
            <th>Öncelik</th>
            <th>Durum</th>
            <th>Oluşturulma Tarihi</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>
                <td>@ticket.Title</td>
                <td>@ticket.Description</td>
                <td>@ticket.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
