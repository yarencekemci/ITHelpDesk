@model List<ITHelpDesk.Entities.Ticket>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">IT Help Desk Dashboard</h2>
        <p class="text-muted mb-0">Destek taleplerinin genel durumu</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Yeni Destek Talebi
    </a>
</div>

<!-- dashboard kartları -->
<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Open Tickets</p>
                <h2 class="fw-bold mb-0">@ViewBag.OpenCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Pending</p>
                <h2 class="fw-bold mb-0">@ViewBag.PendingCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Resolved</p>
                <h2 class="fw-bold mb-0">@ViewBag.ResolvedCount</h2>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Unresolved</p>
                <h2 class="fw-bold mb-0">@ViewBag.UnresolvedCount</h2>
            </div>
        </div>
    </div>

</div>

<!-- destek talepleri -->
<div class="card shadow-sm border-0">
    <div class="card-body">

        <h5 class="fw-bold mb-3">Destek Talepleri</h5>

        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Talep No</th>
                        <th>Başlık</th>
                        <th>Talep Sahibi</th>
                        <th>Atanan Personel</th>
                        <th>Açıklama</th>
                        <th>Kategori</th>
                        <th>Öncelik</th>
                        <th>Durum</th>
                        <th>Oluşturulma Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                Henüz destek talebi bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@ticket.Id">
                                        #@ticket.Id
                                    </a>
                                </td>

                                <td>@ticket.Title</td>
                                <td>@ticket.User?.FullName</td>
                                <td>@ticket.AssignedTo?.FullName</td>
                                <td>@ticket.Description</td>
                                <td>@ticket.Category?.Name</td>
                                <td>@ticket.Priority?.Name</td>
                                <td>@ticket.Status?.Name</td>

                                <td>
                                    @ticket.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@ticket.Id"
                                       class="btn btn-warning btn-sm">
                                        Düzenle
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@ticket.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bu destek talebini silmek istediğine emin misin?');">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
